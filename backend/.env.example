# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Public base URL of THIS backend's own /api — used to build the recipient-facing
# secure download links in delivery emails (GET /api/deliver/download?token=...),
# so those links open the raw PDF directly and never route through the frontend app.
# Only needs changing if the backend isn't reachable at http://localhost:<PORT>/api
# (e.g. deployed behind a different host/domain).
API_BASE_URL=http://localhost:5000/api

# MySQL (XAMPP defaults shown)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=doc_automation

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# HMAC signing secret for digital signatures (FR-024) — keep this secret and back it up;
# losing it invalidates the ability to re-verify previously issued signatures' provenance.
HMAC_SECRET=change_this_to_a_long_random_string_too

# Encrypts external-database connection passwords at rest (see
# src/utils/encryption.js / externalDbController.js). Must be its OWN long random
# value — never reuse JWT_SECRET/HMAC_SECRET here. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
EXTERNAL_DB_ENC_KEY=change_this_to_a_long_random_string_as_well

# SMTP (FR-022/FR-030: OTP + all workflow email notifications). If SMTP_HOST is left
# blank, emails (including OTP codes) are only logged to the console instead of sent
# (see src/utils/emailService.js) — so local dev still works without setup, but the
# Approver will never actually receive their OTP by email until this is filled in.
#
# Using Gmail (smtp.gmail.com) as shown below:
#   1. The account must have 2-Step Verification turned on.
#   2. SMTP_PASSWORD must be a 16-character Gmail "App Password"
#      (Google Account -> Security -> 2-Step Verification -> App passwords),
#      NOT the account's normal login password — Gmail rejects plain
#      passwords over SMTP.
#   3. Paste the app password below with no spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=birukbelay212121@gmail.com
SMTP_PASSWORD=
SMTP_FROM=birukbelay212121@gmail.com

# SMS OTP delivery (FR-023). Leave SMS_PROVIDER blank to log OTPs to the console instead
# of texting them (fine for local dev). To actually deliver:
#   1. npm install   (the "twilio" package is now a listed dependency)
#   2. Set SMS_PROVIDER=twilio and fill in the three TWILIO_* values from
#      https://console.twilio.com (Account SID, Auth Token, and a Twilio phone number
#      capable of sending SMS to your country).
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Used to convert locally-formatted phone numbers (e.g. 0961733380) to the E.164 format
# SMS providers require (+2519...). Change if most of your users are in another country.
PHONE_DEFAULT_COUNTRY_CODE=251
